in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

options:gfx_hz=20

@init

MAX_FILT = 12;
MAX_STAGES = 4;
MAX_CHANNELS = 2;
NODE_HIT_RADIUS = 9;
DOUBLE_CLICK_TIME = 0.35;

// node frequencies are stored as 0-100 percent, log-mapped between
// MIN_FREQ_HZ and (a safety margin below) the CURRENT project's Nyquist -
// this lets dragging/automation reach all the way up to Nyquist regardless
// of sample rate, instead of a fixed Hz ceiling.
MIN_FREQ_HZ = 20;
nyquist_hz = 0.5 * srate;
nyquist_margin_hz = 0.49 * srate;
freq_log_max = log(nyquist_margin_hz / MIN_FREQ_HZ);

// Q is edited/automated log-scaled (0.1..200 spans 3 decades) so the
// dial/mouse-wheel feel uniform across the whole range instead of the
// top ~199 of it being crammed into the last few drag-pixels.
Q_MIN = 0.1;
Q_MAX = 200;
q_log_range = log(Q_MAX / Q_MIN);

// run the actual filter math at 2x the host sample rate (tan() warping/
// cramping near Nyquist at high Q depends only on freq/proc_srate - see
// jsfx-conventions.md - so doubling proc_srate halves that ratio for any
// given Hz value). oversample_upsamplers.jsfx-inc's polyphase half-band
// FIR (vendored from Saike Tools/Basics) handles the up/downsampling;
// its 32-sample group delay is reported via pdc_delay so PDC-aware hosts
// compensate automatically.
OVERSAMPLE_FACTOR = 2;
proc_srate = srate * OVERSAMPLE_FACTOR;
pdc_delay = 32;
upL.init_upSampler2(); upR.init_upSampler2();
downL.init_upSampler2(); downR.init_upSampler2();

function per_to_freq(per)
(
  MIN_FREQ_HZ * exp(freq_log_max * per / 100);
);

function freq_to_per(freq)
(
  100 * log(max(freq, MIN_FREQ_HZ) / MIN_FREQ_HZ) / freq_log_max;
);

// ---------------------------------------------------------------------
// raw (unsmoothed) frequency/gain for a node's drawn/hit-tested position -
// reads the slider directly instead of the @block-smoothed freq_s/gain_s
// (which exists only to de-zipper the audio path), so a dragged node
// tracks the mouse 1:1 every frame instead of visibly lagging behind it.
// filt == -1 selects the wideband gain slider.
// ---------------------------------------------------------------------
function node_freq(filt)
(
  per_to_freq(slider(1 + filt * 5));
);

function node_gain(filt)
(
  filt == -1 ? slider(61) : slider(2 + filt * 5);
);

function q_to01(q)
(
  log(max(q, Q_MIN) / Q_MIN) / q_log_range;
);

function q01_to_q(v01)
(
  Q_MIN * exp(q_log_range * max(0, min(1, v01)));
);

freemem = 0;
// spectrum.jsfx-inc owns its own memory allocator - hand it our current
// freemem, then reclaim the pointer afterwards so our arrays don't overlap.
spectrum.init_memory(freemem);
spectrum.init();
freemem = spectrum.get_memory_index();

spectrum.min_freq = MIN_FREQ_HZ;
spectrum.max_freq = nyquist_hz;
spectrum.freq_log_max = log(spectrum.max_freq / spectrum.min_freq);
spectrum.ceiling = 36;
spectrum.noise_floor = -90;
spectrum.top_margin = 10;
spectrum.bottom_margin = 150;
spectrum.left_margin = 20;
spectrum.right_margin = 20;
spectrum.set_block_size(2048);
// buffer 0 = pre-filterbank (input), buffer 1 = post-filterbank (output)
spectrum.set_color(0, 0.2, 0.8, 0.85, 0.5);
spectrum.set_fill(0, 1);
spectrum.set_color(1, 0.3, 0.9, 0.4, 0.55);
spectrum.set_fill(1, 1);

coef_g = freemem; freemem += MAX_FILT;
coef_k = freemem; freemem += MAX_FILT;
coef_a1 = freemem; freemem += MAX_FILT;
coef_a2 = freemem; freemem += MAX_FILT;
coef_a3 = freemem; freemem += MAX_FILT;

state_z1 = freemem; freemem += MAX_FILT * MAX_STAGES * MAX_CHANNELS;
state_z2 = freemem; freemem += MAX_FILT * MAX_STAGES * MAX_CHANNELS;

freq_s = freemem; freemem += MAX_FILT;
gain_s = freemem; freemem += MAX_FILT;
q_s = freemem; freemem += MAX_FILT;
mute_gain_s = freemem; freemem += MAX_FILT;
gain_lin = freemem; freemem += MAX_FILT;
slope = freemem; freemem += MAX_FILT;
prev_slope = freemem; freemem += MAX_FILT;
default_freq = freemem; freemem += MAX_FILT;

// ---------------------------------------------------------------------
// generic one-pole smoother, reusable for any parameter
// ---------------------------------------------------------------------
function smooth_towards(target, current, coef)
(
  current + (target - current) * coef;
);

// ---------------------------------------------------------------------
// Cytomic/Andy Simper "topology-preserving transform" (TPT) state-variable
// bandpass, constant 0dB peak gain. Unlike a direct-form RBJ biquad (which
// uses the un-prewarped w0 = 2*pi*f/srate), the g = tan(pi*f/srate) term
// here properly prewarps the frequency, so Q/bandwidth stays accurate
// instead of cramping as freq approaches Nyquist. Reference:
// https://cytomic.com/files/dsp/SvfLinearTrapOptimised2.pdf (same math
// ReEQ.jsfx uses via its svf_filter.jsfx-inc).
// ---------------------------------------------------------------------
function calc_filter_coefs(filt)
local(g)
(
  g = tan($pi * freq_s[filt] / proc_srate);
  coef_g[filt] = g;
  coef_k[filt] = 1 / q_s[filt];
  coef_a1[filt] = 1 / (1 + g * (g + coef_k[filt]));
  coef_a2[filt] = g * coef_a1[filt];
  coef_a3[filt] = g * coef_a2[filt];
);

// ---------------------------------------------------------------------
// run one sample through filt's cascade of slope[filt] identical TPT
// bandpass stages
// ---------------------------------------------------------------------
function bandpass_cascade(filt, ch, x)
local(base, stage, n, ic1, ic2, v1, v2, v3, a1, a2, a3, k)
(
  base = ch * MAX_FILT * MAX_STAGES + filt * MAX_STAGES;
  n = slope[filt];
  a1 = coef_a1[filt]; a2 = coef_a2[filt]; a3 = coef_a3[filt]; k = coef_k[filt];
  stage = 0;
  while (stage < n) (
    ic1 = state_z1[base + stage];
    ic2 = state_z2[base + stage];
    v3 = x - ic2;
    v1 = a1 * ic1 + a2 * v3;
    v2 = ic2 + a2 * ic1 + a3 * v3;
    state_z1[base + stage] = 2 * v1 - ic1;
    state_z2[base + stage] = 2 * v2 - ic2;
    x = v1 * k;
    stage += 1;
  );
  x;
);

// ---------------------------------------------------------------------
// zero out stage state beyond the new (shrunk) stage count, so a filter
// doesn't resume with stale state (and an audible click) if slope grows
// again later
// ---------------------------------------------------------------------
function clear_stale_stage_state(filt, new_n, old_n)
local(ch, stage, base)
(
  ch = 0;
  while (ch < MAX_CHANNELS) (
    base = ch * MAX_FILT * MAX_STAGES + filt * MAX_STAGES;
    stage = new_n;
    while (stage < old_n) (
      state_z1[base + stage] = 0;
      state_z2[base + stage] = 0;
      stage += 1;
    );
    ch += 1;
  );
);

// ---------------------------------------------------------------------
// parallel sum of all filters, plus the wideband complement. Filters are
// ALWAYS processed (even muted) so their state stays warm - mute_gain_s
// crossfades the output instead, avoiding clicks.
// ---------------------------------------------------------------------
function filterbank_process(ch, x)
local(filt, filtered_sum, wide)
(
  filtered_sum = 0;
  filt = 0;
  while (filt < MAX_FILT) (
    filtered_sum += mute_gain_s[filt] * gain_lin[filt] * bandpass_cascade(filt, ch, x);
    filt += 1;
  );
  wide = x - filtered_sum;
  filtered_sum + wideband_mute_gain_s * wideband_gain_lin * wide;
);

// ---------------------------------------------------------------------
// combined parallel-filterbank magnitude response (dB) at a given
// frequency. Unlike a SERIAL cascade (where stage responses multiply),
// these filters run in PARALLEL and are summed - so each filter's complex
// response must be raised to its own slope's power (identical cascaded
// stages multiply), then all filters' complex responses are SUMMED
// (real/imaginary parts separately) before the aggregate is converted to
// dB at the very end.
// ---------------------------------------------------------------------
function calc_filterbank_response_db(freq)
local(filt, zr, zi, zsq_r, zsq_i, twoz_r, twoz_i, g, k, gsq, gk, nr, ni, dr, di, norm, hr, hi, tr, ti, nrr, nii, stage, sumre, sumim, gfac, wg)
(
  // z^-1 = e^{-i*2*pi*freq/proc_srate}, shared by every filter at this freq
  zr = cos(-2 * $pi * freq / proc_srate);
  zi = sin(-2 * $pi * freq / proc_srate);
  zsq_r = zr * zr - zi * zi;
  zsq_i = 2 * zr * zi;
  twoz_r = 2 * zr; twoz_i = 2 * zi;

  sumre = 0; sumim = 0;
  filt = 0;
  while (filt < MAX_FILT) (
    gfac = mute_gain_s[filt] * gain_lin[filt];
    gfac > 0.0001 ? (
      // closed-form complex response of one TPT bandpass stage (m0=0, m1=k, m2=0)
      g = coef_g[filt]; k = coef_k[filt];
      gsq = g * g; gk = g * k;
      nr = -gk * (zsq_r - 1.0);
      ni = -gk * zsq_i;
      dr = gsq + gk + zsq_r * (gsq - gk + 1.0) + zr * (2 * gsq - 2.0) + 1.0;
      di = zsq_i * (gsq - gk + 1.0) + zi * (2 * gsq - 2.0);
      norm = max(dr * dr + di * di, 0.0000000001);
      hr = (nr * dr + ni * di) / norm;
      hi = (ni * dr - nr * di) / norm;
      tr = 1; ti = 0;
      stage = 0;
      while (stage < slope[filt]) (
        nrr = tr * hr - ti * hi;
        nii = tr * hi + ti * hr;
        tr = nrr; ti = nii;
        stage += 1;
      );
      sumre += tr * gfac;
      sumim += ti * gfac;
    );
    filt += 1;
  );

  // fold in the wideband complement: H_wide = wg * (1 - H_filtered_sum)
  wg = wideband_mute_gain_s * wideband_gain_lin;
  sumre = sumre + wg * (1 - sumre);
  sumim = sumim - wg * sumim;

  20 * log10(max(sqrt(sumre * sumre + sumim * sumim), 0.0000000001));
);

// ---------------------------------------------------------------------
// draw one response-curve segment as several overlaid offset strokes
// (1 full-alpha center + 4 adjacent + 2 diagonal, each lower-alpha), the
// same technique as ReJJ/ReEQ/ReEQ.jsfx's draw_thick_line() scaled up
// for a visibly thicker, more anti-aliased look than a plain gfx_line().
// ---------------------------------------------------------------------
function draw_resp_thick_line(x1, y1, x2, y2)
(
  gfx_a = 0.95;
  gfx_line(x1, y1, x2, y2, 1);
  gfx_a = 0.5;
  gfx_line(x1 - 1, y1, x2 - 1, y2, 1);
  gfx_line(x1 + 1, y1, x2 + 1, y2, 1);
  gfx_line(x1, y1 - 1, x2, y2 - 1, 1);
  gfx_line(x1, y1 + 1, x2, y2 + 1, 1);
  gfx_a = 0.22;
  gfx_line(x1 - 1, y1 - 1, x2 + 1, y2 - 1, 1);
  gfx_line(x1 - 1, y1 + 1, x2 + 1, y2 + 1, 1);
);

// ---------------------------------------------------------------------
// overlay the combined filterbank response across the spectrum axes.
// Computes the EXACT (non-LUT, non-interpolated) response at every pixel
// column, same approach as ReEQ.jsfx's draw_filter_response()/
// draw_filter_bands() - no caching/coarse-resolution pass at all, so
// narrow (high-Q) peaks and closely-overlapping filters are always
// rendered at full accuracy instead of being smeared by a fixed-size
// lookup table. This replaces an earlier two-pass (coarse LUT + fine
// exact clusters) approach, which drew two different approximations of
// the same curve overlaid on top of each other and produced visible
// spurious "multiple lines" artifacts.
// ---------------------------------------------------------------------
function draw_response_curve()
local(x, freq, db, y, px, py, first)
(
  gfx_r = 1; gfx_g = 1; gfx_b = 1;
  first = 1;
  x = spectrum.left_margin;
  while (x <= gfx_w - spectrum.right_margin) (
    freq = spectrum.x_to_freq(x);
    db = calc_filterbank_response_db(freq);
    y = spectrum.db_to_y(db);
    first ? ( px = x; py = y; first = 0; ) : (
      draw_resp_thick_line(px, py, x, y);
      px = x; py = y;
    );
    x += 1;
  );
);

// ---------------------------------------------------------------------
// HSV to RGB, used to give every filter node a distinct, stable color
// (writes into the globals node_r/node_g/node_b)
// ---------------------------------------------------------------------
function hsv_to_rgb(h, s, v)
local(i, f, p, q, t)
(
  i = floor(h * 6);
  f = h * 6 - i;
  p = v * (1 - s);
  q = v * (1 - f * s);
  t = v * (1 - (1 - f) * s);
  i = i % 6;
  i == 0 ? ( node_r = v; node_g = t; node_b = p; ) :
  i == 1 ? ( node_r = q; node_g = v; node_b = p; ) :
  i == 2 ? ( node_r = p; node_g = v; node_b = t; ) :
  i == 3 ? ( node_r = p; node_g = q; node_b = v; ) :
  i == 4 ? ( node_r = t; node_g = p; node_b = v; ) :
  ( node_r = v; node_g = p; node_b = q; );
);

function find_node_at(mx, my)
local(filt, nx, ny, d2, best, bestd2)
(
  best = -1;
  bestd2 = NODE_HIT_RADIUS * NODE_HIT_RADIUS;
  filt = 0;
  while (filt < MAX_FILT) (
    slider(5 + filt * 5) <= 0.5 ? (
      nx = spectrum.freq_to_x(node_freq(filt));
      ny = spectrum.db_to_y(node_gain(filt));
      d2 = sqr(mx - nx) + sqr(my - ny);
      d2 <= bestd2 ? ( best = filt; bestd2 = d2; );
    );
    filt += 1;
  );
  best == -1 ? (
    nx = gfx_w - spectrum.right_margin - 20;
    ny = spectrum.db_to_y(node_gain(-1));
    d2 = sqr(mx - nx) + sqr(my - ny);
    d2 <= bestd2 ? best = -2;
  );
  best;
);

function draw_filter_nodes()
local(filt, nx, ny, r, wx, wy, wr)
(
  // muted filters' nodes are hidden entirely - everything unmuted (active
  // or not) is always shown, regardless of selection.
  filt = 0;
  while (filt < MAX_FILT) (
    slider(5 + filt * 5) <= 0.5 ? (
      nx = spectrum.freq_to_x(node_freq(filt));
      ny = spectrum.db_to_y(node_gain(filt));
      hsv_to_rgb(filt / MAX_FILT, 0.75, 1);
      r = (filt == hovered_filt || filt == selected_filt || filt == drag_filt) ? 7 : 5;
      gfx_set(node_r, node_g, node_b, 0.95);
      gfx_circle(nx, ny, r, 1, 1);
      filt == selected_filt ? (
        gfx_set(1, 1, 1, 0.9);
        gfx_circle(nx, ny, r + 3, 0, 1);
      );
    );
    filt += 1;
  );

  // wideband: a distinct square marker (not frequency-specific, so it sits
  // at a fixed x) showing/editing the wideband gain, muted via slider62
  wx = gfx_w - spectrum.right_margin - 20;
  wy = spectrum.db_to_y(node_gain(-1));
  wr = (hovered_filt == -2 || drag_filt == -2 || selected_filt == -2) ? 7 : 5;
  slider(62) > 0.5 ? (
    gfx_set(0.85, 0.85, 0.85, 0.9);
    gfx_rect(wx - wr, wy - wr, wr * 2, wr * 2);
    gfx_set(0.1, 0.1, 0.1, 1);
    gfx_rect(wx - wr + 1, wy - wr + 1, wr * 2 - 2, wr * 2 - 2);
  ) : (
    gfx_set(0.85, 0.85, 0.85, 0.95);
    gfx_rect(wx - wr, wy - wr, wr * 2, wr * 2);
  );
);

// ---------------------------------------------------------------------
// vertical drop-line from the selected filter's node down to the bottom
// of the graph, plus exact white readouts of its frequency (over the
// graph's own frequency-axis labels) and gain (over the dB-axis labels).
// ---------------------------------------------------------------------
function draw_selected_indicator()
local(by, nx, ny, w, h)
(
  by = gfx_h - spectrum.bottom_margin;

  selected_filt >= 0 ? (
    nx = spectrum.freq_to_x(node_freq(selected_filt));
    ny = spectrum.db_to_y(node_gain(selected_filt));

    gfx_set(1, 1, 1, 0.3);
    gfx_line(nx, ny, nx, by, 0);

    sprintf(#indicator_txt, "%.2f Hz", node_freq(selected_filt));
    gfx_measurestr(#indicator_txt, w, h);
    gfx_set(1, 1, 1, 1);
    gfx_x = nx - w / 2; gfx_y = gfx_h - (gfx_texth - 2) - spectrum.bottom_margin;
    gfx_drawstr(#indicator_txt);

    sprintf(#indicator_txt, "%.2f dB", node_gain(selected_filt));
    gfx_measurestr(#indicator_txt, w, h);
    gfx_x = 0; gfx_y = ny - gfx_texth * 0.5;
    gfx_drawstr(#indicator_txt);
  ) : selected_filt == -2 ? (
    ny = spectrum.db_to_y(node_gain(-1));
    sprintf(#indicator_txt, "%.2f dB", node_gain(-1));
    gfx_measurestr(#indicator_txt, w, h);
    gfx_set(1, 1, 1, 1);
    gfx_x = 0; gfx_y = ny - gfx_texth * 0.5;
    gfx_drawstr(#indicator_txt);
  );
);

// ---------------------------------------------------------------------
// typed numeric entry (edit_filt == -1 means the wideband; its only
// editable field is gain, field is still passed as 1 for consistency)
// ---------------------------------------------------------------------
function start_text_edit(filt, field)
(
  edit_active = 1;
  edit_filt = filt;
  edit_field = field;
  #edit_text = "";
);

function commit_text_edit()
local(val, ok, idx)
(
  ok = match("%f", #edit_text, val);
  ok ? (
    edit_filt == -1 ? (
      slider(61) = max(-80, min(30, val));
      slider_automate(slider(61));
    ) : (
      edit_field == 0 ? ( idx = 1 + edit_filt * 5; slider(idx) = freq_to_per(max(MIN_FREQ_HZ, min(nyquist_margin_hz, val))); ) :
      edit_field == 1 ? ( idx = 2 + edit_filt * 5; slider(idx) = max(-80, min(30, val)); ) :
      edit_field == 2 ? ( idx = 3 + edit_filt * 5; slider(idx) = max(Q_MIN, min(Q_MAX, val)); ) :
      ( idx = 4 + edit_filt * 5; slider(idx) = max(1, min(4, floor(val + 0.5))); );
      slider_automate(slider(idx));
    );
  );
  edit_active = 0;
);

function handle_text_edit()
local(c)
(
  // call unconditionally every frame so mouse_cap registers clicks reliably
  c = gfx_getchar();
  edit_active ? (
    c == 13 ? commit_text_edit() :
    c == 27 ? edit_active = 0 :
    c == 8 ? ( strlen(#edit_text) > 0 ? strcpy_substr(#edit_text, #edit_text, 0, strlen(#edit_text) - 1); ) :
    ((c >= 48 && c <= 57) || c == 46 || c == 45) ? (
      strlen(#edit_text) == 0 ? sprintf(#edit_text, "%c", c) : str_setchar(#edit_text, strlen(#edit_text), c);
    );
  );
);

function reset_filter(filt)
local(idx)
(
  idx = 1 + filt * 5; slider(idx) = freq_to_per(default_freq[filt]); slider_automate(slider(idx));
  idx = 2 + filt * 5; slider(idx) = -80; slider_automate(slider(idx));
  idx = 3 + filt * 5; slider(idx) = 200; slider_automate(slider(idx));
  idx = 4 + filt * 5; slider(idx) = 1; slider_automate(slider(idx));
);

function duplicate_filter_to_empty_slot(filt)
local(target, i)
(
  target = -1;
  i = 0;
  while (i < MAX_FILT && target == -1) (
    (i != filt) && (slider(5 + i * 5) > 0.5) ? target = i;
    i += 1;
  );
  target >= 0 ? (
    slider(1 + target * 5) = slider(1 + filt * 5); slider_automate(slider(1 + target * 5));
    slider(2 + target * 5) = slider(2 + filt * 5); slider_automate(slider(2 + target * 5));
    slider(3 + target * 5) = slider(3 + filt * 5); slider_automate(slider(3 + target * 5));
    slider(4 + target * 5) = slider(4 + filt * 5); slider_automate(slider(4 + target * 5));
    slider(5 + target * 5) = 0; slider_automate(slider(5 + target * 5));
  );
);

function show_filter_context_menu(filt)
local(choice)
(
  #menu = "";
  #menu += "Set Frequency...|";
  #menu += "Set Gain...|";
  #menu += "Set Q...|";
  #menu += "Slope: 1 Stage|";
  #menu += "Slope: 2 Stages|";
  #menu += "Slope: 3 Stages|";
  #menu += "Slope: 4 Stages|";
  #menu += (slider(5 + filt * 5) > 0.5 ? "Unmute" : "Mute");
  #menu += "|Zero Gain|Reset Filter|Duplicate Filter to Empty Slot";

  gfx_x = mouse_x; gfx_y = mouse_y;
  choice = gfx_showmenu(#menu);

  choice == 1 ? start_text_edit(filt, 0) :
  choice == 2 ? start_text_edit(filt, 1) :
  choice == 3 ? start_text_edit(filt, 2) :
  choice == 4 ? ( slider(4 + filt * 5) = 1; slider_automate(slider(4 + filt * 5)); ) :
  choice == 5 ? ( slider(4 + filt * 5) = 2; slider_automate(slider(4 + filt * 5)); ) :
  choice == 6 ? ( slider(4 + filt * 5) = 3; slider_automate(slider(4 + filt * 5)); ) :
  choice == 7 ? ( slider(4 + filt * 5) = 4; slider_automate(slider(4 + filt * 5)); ) :
  choice == 8 ? ( slider(5 + filt * 5) = slider(5 + filt * 5) > 0.5 ? 0 : 1; slider_automate(slider(5 + filt * 5)); ) :
  choice == 9 ? ( slider(2 + filt * 5) = 0; slider_automate(slider(2 + filt * 5)); ) :
  choice == 10 ? reset_filter(filt) :
  choice == 11 ? duplicate_filter_to_empty_slot(filt);
);

function process_mouse_nodes()
local(now, idx, by, v01)
(
  // only hit-test spectrum-graph nodes above the bottom panel, so a click
  // on a panel widget (dial/button/stepper) never gets misread as a
  // click on empty graph space, which used to clear selected_filt and
  // make the panel disappear the instant you tried to adjust it.
  by = gfx_h - spectrum.bottom_margin;
  hovered_filt = (mouse_y < by) ? find_node_at(mouse_x, mouse_y) : -1;

  (mouse_cap & 1) && !(mouse_cap_prev & 1) && (mouse_y < by) ? (
    hovered_filt >= 0 ? (
      now = time_precise();
      (last_click_filt == hovered_filt) && (now - last_click_time < DOUBLE_CLICK_TIME) ? (
        idx = 5 + hovered_filt * 5;
        slider(idx) = slider(idx) > 0.5 ? 0 : 1;
        slider_automate(slider(idx));
      ) : (
        drag_filt = hovered_filt;
        selected_filt = hovered_filt;
        // anchor the drag to the OFFSET between the click point and the
        // node's actual current pixel position (which can be up to
        // NODE_HIT_RADIUS away from dead-center), instead of snapping the
        // node straight to the mouse - this is what caused the "abrupt
        // frequency jump" the instant you grabbed a node slightly off-
        // center; same technique as the panel's drag_apply_drag() dials.
        drag_anchor_dx = mouse_x - spectrum.freq_to_x(node_freq(hovered_filt));
        drag_anchor_dy = mouse_y - spectrum.db_to_y(node_gain(hovered_filt));
      );
      last_click_time = now;
      last_click_filt = hovered_filt;
    ) : hovered_filt == -2 ? (
      drag_filt = -2;
      drag_anchor_dy = mouse_y - spectrum.db_to_y(node_gain(-1));
    ) : (
      selected_filt = -1;
    );
  );

  (mouse_cap & 1) && drag_filt >= 0 ? (
    idx = 1 + drag_filt * 5;
    slider(idx) = freq_to_per(max(MIN_FREQ_HZ, min(nyquist_margin_hz, spectrum.x_to_freq(mouse_x - drag_anchor_dx))));
    slider_automate(slider(idx));
    idx = 2 + drag_filt * 5;
    slider(idx) = max(-80, min(30, spectrum.y_to_db(mouse_y - drag_anchor_dy)));
    slider_automate(slider(idx));
  );

  (mouse_cap & 1) && drag_filt == -2 ? (
    slider(61) = max(-80, min(30, spectrum.y_to_db(mouse_y - drag_anchor_dy)));
    slider_automate(slider(61));
  );

  !(mouse_cap & 1) ? drag_filt = -1;

  // Q is only wheel-adjustable once its node has been clicked/selected -
  // merely hovering used to be enough, which made the wheel change
  // whichever node the mouse happened to be sitting over.
  mouse_wheel != 0 && hovered_filt >= 0 && hovered_filt == selected_filt ? (
    idx = 3 + hovered_filt * 5;
    v01 = max(0, min(1, q_to01(slider(idx)) + (mouse_wheel / 120) * 0.03));
    slider(idx) = q01_to_q(v01);
    slider_automate(slider(idx));
    mouse_wheel = 0;
  );

  (mouse_cap & 2) && !(mouse_cap_prev & 2) && hovered_filt >= 0 ? (
    show_filter_context_menu(hovered_filt);
  );
);

function draw_clickable_value(x, y, w, h, text, filt, field)
(
  (mouse_cap & 1) && !(mouse_cap_prev & 1) && mouse_x >= x && mouse_x <= x + w && mouse_y >= y && mouse_y <= y + h ? start_text_edit(filt, field);
  gfx_x = x; gfx_y = y;
  gfx_drawstr(text);
);

function draw_text_edit_box(x, y)
(
  gfx_set(0, 0, 0, 0.9);
  gfx_rect(x, y - 2, 90, 16);
  gfx_set(1, 1, 0.4, 1);
  gfx_rect(x, y - 2, 90, 1);
  gfx_x = x + 3; gfx_y = y;
  gfx_drawstr(#edit_text);
  gfx_drawstr("_");
);

// ---------------------------------------------------------------------
// rounded "capsule" shape (rect with semicircular end caps), same
// geometry as ReJJ/ReEQ/ReEQ.jsfx's draw_capsule().
// ---------------------------------------------------------------------
function draw_capsule(x, y, w, h)
local(radius, halfh)
(
  radius = h * 0.5;
  halfh = h * 0.5;
  gfx_rect(x, y, w, h + 1);
  gfx_circle(x, y + halfh, radius, 1);
  gfx_circle(x + w, y + halfh, radius, 1);
);

// ---------------------------------------------------------------------
// normalized (0..1) position of a dial's current value, for drawing.
// field: 0=freq (uses the slider's own 0-100% storage directly),
// 1=gain (-80..30 dB, filt==-1 selects the wideband gain slider),
// 2=q (Q_MIN..Q_MAX, log-scaled), 3=slope (1-4 stages).
// ---------------------------------------------------------------------
function dial_get01(filt, field)
(
  field == 0 ? slider(1 + filt * 5) / 100 :
  field == 1 ? ( (slider(filt == -1 ? 61 : 2 + filt * 5) + 80) / 110 ) :
  field == 2 ? q_to01(slider(3 + filt * 5)) :
  ( (slider(4 + filt * 5) - 1) / 3 );
);

// ---------------------------------------------------------------------
// apply a vertical mouse-drag delta (in pixels) to the dial's underlying
// slider - drag up increases, drag down decreases, mirroring ReEQ's
// handle_number_dial() convention.
// ---------------------------------------------------------------------
function dial_apply_drag(filt, field, dy)
local(idx, v01)
(
  field == 0 ? (
    idx = 1 + filt * 5;
    slider(idx) = max(0, min(100, slider(idx) - dy * (100 / 250)));
  ) : field == 1 ? (
    idx = filt == -1 ? 61 : 2 + filt * 5;
    slider(idx) = max(-80, min(30, slider(idx) - dy * (110 / 250)));
  ) : field == 2 ? (
    idx = 3 + filt * 5;
    v01 = max(0, min(1, q_to01(slider(idx)) - dy / 250));
    slider(idx) = q01_to_q(v01);
  ) : (
    // slope is a quantized 1-4 integer, so re-deriving v01 from the
    // already-rounded slider value (as the other fields do) would throw
    // away any sub-step drag progress every frame, making the dial feel
    // nearly impossible to turn - dial_drag_v01 instead accumulates the
    // continuous position across the whole drag gesture.
    idx = 4 + filt * 5;
    dial_drag_v01 = max(0, min(1, dial_drag_v01 - dy / 250));
    slider(idx) = floor(1 + dial_drag_v01 * 3 + 0.5);
  );
  slider_automate(slider(idx));
);

// ---------------------------------------------------------------------
// one rotary dial widget: label above, arc+needle indicator, click-to-
// type value text below (reuses draw_clickable_value/draw_text_edit_box),
// drag-anywhere-on-the-dial-face to adjust (reuses the de-hum-shared
// gfx_arc knob look from ReJJ/ReEQ/ReEQ.jsfx's draw_dial()).
// ---------------------------------------------------------------------
function draw_param_dial(cx, cy, r, filt, field, label, valuetext)
local(v01, start, end, ang, arc_ofs, w, h, dist)
(
  v01 = max(0, min(1, dial_get01(filt, field)));
  start = 0.75 * $pi;
  end = 2.25 * $pi;
  ang = start + (end - start) * v01;
  // gfx_arc's angle 0 points to the TOP of the circle, 90 degrees
  // rotated from the cos()/sin() convention used below for the needle -
  // ReEQ.jsfx's draw_dial() compensates for this with the same offset,
  // which filterbank's arc was previously missing (the yellow fill and
  // the white needle pointed at visibly different angles).
  arc_ofs = $pi / 2;

  gfx_set(0.22, 0.22, 0.26, 1);
  gfx_arc(cx, cy, r, start + arc_ofs, end + arc_ofs, 1);
  gfx_set(0.95, 0.75, 0.3, 1);
  gfx_arc(cx, cy, r, start + arc_ofs, ang + arc_ofs, 1);
  gfx_set(1, 1, 1, 1);
  gfx_line(cx, cy, cx + r * 0.8 * cos(ang), cy + r * 0.8 * sin(ang));
  gfx_set(0.15, 0.15, 0.18, 1);
  gfx_circle(cx, cy, r * 0.55, 1);

  gfx_set(0.75, 0.75, 0.8, 1);
  gfx_measurestr(label, w, h);
  gfx_x = cx - w / 2; gfx_y = cy - r - 16;
  gfx_drawstr(label);

  gfx_measurestr(valuetext, w, h);
  gfx_set(1, 1, 1, 0.95);
  edit_active && edit_filt == filt && edit_field == field ? draw_text_edit_box(cx - w / 2, cy + r + 6) :
    draw_clickable_value(cx - w / 2, cy + r + 6, w, 14, valuetext, filt, field);

  dist = sqrt((mouse_x - cx) * (mouse_x - cx) + (mouse_y - cy) * (mouse_y - cy));
  (mouse_cap & 1) && !(mouse_cap_prev & 1) && dist <= r + 4 ? (
    dial_drag_active = 1; dial_drag_filt = filt; dial_drag_field = field; dial_drag_oldy = mouse_y;
    dial_drag_v01 = dial_get01(filt, field);
  );
  (mouse_cap & 1) && dial_drag_active && dial_drag_filt == filt && dial_drag_field == field ? (
    dial_apply_drag(filt, field, mouse_y - dial_drag_oldy);
    dial_drag_oldy = mouse_y;
  );
);

function draw_filter_detail_row(filt, x, y, w, h)
local(idx, bx, by2, bw, bh, muted)
(
  gfx_set(0.11, 0.11, 0.14, 1);
  gfx_rect(x, y, w, h);
  gfx_set(0.3, 0.3, 0.36, 1);
  gfx_rect(x, y, w, 1);
  gfx_rect(x, y + h - 1, w, 1);
  gfx_rect(x, y, 1, h);
  gfx_rect(x + w - 1, y, 1, h);

  hsv_to_rgb(filt / MAX_FILT, 0.75, 1);
  gfx_set(node_r, node_g, node_b, 1);
  gfx_rect(x + 8, y + 8, 10, 10);

  gfx_set(1, 1, 1, 0.9);
  gfx_x = x + 24; gfx_y = y + 6; gfx_printf("Filter %d", filt + 1);

  idx = 5 + filt * 5;
  muted = slider(idx) > 0.5;
  bw = 60; bh = 18; bx = x + w - bw - 10; by2 = y + 8;
  gfx_set(muted ? 0.55 : 0.2, muted ? 0.2 : 0.55, 0.2, 1);
  draw_capsule(bx, by2, bw, bh);
  gfx_set(1, 1, 1, 1);
  gfx_x = bx + 8; gfx_y = by2 + 3;
  gfx_drawstr(muted ? "Muted" : "Active");
  (mouse_cap & 1) && !(mouse_cap_prev & 1) && mouse_x >= bx && mouse_x <= bx + bw && mouse_y >= by2 && mouse_y <= by2 + bh ? (
    slider(idx) = muted ? 0 : 1;
    slider_automate(slider(idx));
  );

  draw_param_dial(x + 90, y + 66, 30, filt, 0, "FREQ", sprintf(#, "%.0f Hz", node_freq(filt)));
  draw_param_dial(x + 230, y + 66, 30, filt, 1, "GAIN", sprintf(#, "%.1f dB", node_gain(filt)));
  draw_param_dial(x + 370, y + 66, 30, filt, 2, "Q", sprintf(#, "%.2f", q_s[filt]));
  draw_param_dial(x + 470, y + 66, 30, filt, 3, "SLOPE", sprintf(#, "%d", slope[filt]));
);

function draw_wideband_control(x, y, w, h)
local(muted, bx, by2, bw, bh)
(
  gfx_set(0.11, 0.11, 0.14, 1);
  gfx_rect(x, y, w, h);
  gfx_set(0.3, 0.3, 0.36, 1);
  gfx_rect(x, y, w, 1);
  gfx_rect(x, y + h - 1, w, 1);
  gfx_rect(x, y, 1, h);
  gfx_rect(x + w - 1, y, 1, h);

  gfx_set(1, 1, 1, 0.9);
  gfx_x = x + 10; gfx_y = y + 6;
  gfx_drawstr("Wideband");

  muted = slider(62) > 0.5;
  bw = 60; bh = 18; bx = x + w - bw - 10; by2 = y + 8;
  gfx_set(muted ? 0.55 : 0.2, muted ? 0.2 : 0.55, 0.2, 1);
  draw_capsule(bx, by2, bw, bh);
  gfx_set(1, 1, 1, 1);
  gfx_x = bx + 8; gfx_y = by2 + 3;
  gfx_drawstr(muted ? "Muted" : "Active");
  (mouse_cap & 1) && !(mouse_cap_prev & 1) && mouse_x >= bx && mouse_x <= bx + bw && mouse_y >= by2 && mouse_y <= by2 + bh ? (
    slider(62) = muted ? 0 : 1;
    slider_automate(slider(62));
  );

  draw_param_dial(x + w / 2, y + 66, 30, -1, 1, "GAIN", sprintf(#, "%.1f dB", node_gain(-1)));
);

function draw_bottom_panel()
local(filt, bx, by, bw, bh, idx, panel_y, panel_h, now)
(
  !(mouse_cap & 1) ? dial_drag_active = 0;

  by = gfx_h - spectrum.bottom_margin;
  gfx_set(0.08, 0.08, 0.1, 1);
  gfx_rect(0, by, gfx_w, spectrum.bottom_margin);

  // navigator strip: single click selects a filter (shown in the shared
  // detail panel below), double-click mutes/unmutes it - same convention
  // as double-clicking a node in the graph.
  bw = 16; bh = 10;
  filt = 0;
  while (filt < MAX_FILT) (
    bx = 6 + filt * (bw + 3);
    hsv_to_rgb(filt / MAX_FILT, 0.75, 1);
    idx = 5 + filt * 5;
    slider(idx) > 0.5 ? gfx_set(0.25, 0.25, 0.25, 1) : gfx_set(node_r, node_g, node_b, 1);
    gfx_rect(bx, by + 4, bw, bh);
    selected_filt == filt ? ( gfx_set(1, 1, 1, 0.9); gfx_rect(bx, by + 2, bw, 1); );
    (mouse_cap & 1) && !(mouse_cap_prev & 1) && mouse_x >= bx && mouse_x <= bx + bw && mouse_y >= by + 4 && mouse_y <= by + 4 + bh ? (
      now = time_precise();
      (nav_last_click_filt == filt) && (now - nav_last_click_time < DOUBLE_CLICK_TIME) ? (
        slider(idx) = slider(idx) > 0.5 ? 0 : 1;
        slider_automate(slider(idx));
      ) : (
        selected_filt = filt;
      );
      nav_last_click_time = now;
      nav_last_click_filt = filt;
    );
    filt += 1;
  );

  // wideband navigator button - selects "wideband" into the SAME shared
  // detail panel below (replacing the old always-visible separate
  // wideband box), double-click still mutes/unmutes it. Same size as a
  // filter dot, right-justified directly under the graph's white
  // wideband marker (not appended after the filter row).
  bx = (gfx_w - spectrum.right_margin - 20) - bw / 2;
  slider(62) > 0.5 ? gfx_set(0.3, 0.3, 0.32, 1) : gfx_set(0.85, 0.85, 0.85, 1);
  gfx_rect(bx, by + 4, bw, bh);
  selected_filt == -2 ? ( gfx_set(1, 1, 1, 0.9); gfx_rect(bx, by + 2, bw, 1); );
  (mouse_cap & 1) && !(mouse_cap_prev & 1) && mouse_x >= bx && mouse_x <= bx + bw && mouse_y >= by + 4 && mouse_y <= by + 4 + bh ? (
    now = time_precise();
    (nav_last_click_filt == -2) && (now - nav_last_click_time < DOUBLE_CLICK_TIME) ? (
      slider(62) = slider(62) > 0.5 ? 0 : 1;
      slider_automate(slider(62));
    ) : (
      selected_filt = -2;
    );
    nav_last_click_time = now;
    nav_last_click_filt = -2;
  );

  panel_y = by + 20;
  panel_h = spectrum.bottom_margin - 26;

  gfx_set(1, 1, 1, 0.9);
  selected_filt >= 0 ? draw_filter_detail_row(selected_filt, 6, panel_y, gfx_w - 12, panel_h) :
  selected_filt == -2 ? draw_wideband_control(6, panel_y, gfx_w - 12, panel_h) : (
    gfx_x = 6; gfx_y = panel_y + panel_h / 2 - 6;
    gfx_drawstr("Click a node to inspect/edit its parameters.");
  );
);

// ---------------------------------------------------------------------
// generic on/off toggle button (same shape as de-hum's)
// ---------------------------------------------------------------------
function draw_toggle_button(bx, by, bw, bh, label, state)
local(inside, clicked)
(
  inside = (mouse_x >= bx) && (mouse_x <= bx + bw) && (mouse_y >= by) && (mouse_y <= by + bh);
  clicked = inside && (mouse_cap & 1) && !(mouse_cap_prev & 1);
  clicked ? state = !state;

  state ? gfx_set(0.2, 0.65, 0.3, 1) : gfx_set(0.3, 0.3, 0.3, 1);
  gfx_rect(bx, by, bw, bh);
  gfx_set(0.8, 0.8, 0.8, 1);
  gfx_rect(bx, by, bw, 1);
  gfx_rect(bx, by + bh - 1, bw, 1);
  gfx_rect(bx, by, 1, bh);
  gfx_rect(bx + bw - 1, by, 1, bh);

  gfx_x = bx + 6; gfx_y = by + 4;
  gfx_printf("%s: %s", label, state ? "ON" : "OFF");

  state;
);

// --- seed per-filter state from current slider values ---
filt = 0;
while (filt < MAX_FILT) (
  freq_s[filt] = per_to_freq(slider(1 + filt * 5));
  gain_s[filt] = slider(2 + filt * 5);
  q_s[filt] = slider(3 + filt * 5);
  slope[filt] = slider(4 + filt * 5);
  prev_slope[filt] = slope[filt];
  mute_gain_s[filt] = slider(5 + filt * 5) > 0.5 ? 0 : 1;
  gain_lin[filt] = 10 ^ (gain_s[filt] / 20);
  default_freq[filt] = freq_s[filt];
  calc_filter_coefs(filt);
  filt += 1;
);

wideband_gain_s = slider(61);
wideband_mute_gain_s = slider(62) > 0.5 ? 0 : 1;
wideband_gain_lin = 10 ^ (wideband_gain_s / 20);

smooth_time = 0.015;

selected_filt = -1;
hovered_filt = -1;
drag_filt = -1;
last_click_time = 0;
last_click_filt = -1;

edit_active = 0;
edit_filt = -1;
edit_field = 0;
#edit_text = "";

dial_drag_active = 0;
dial_drag_filt = -1;
dial_drag_field = -1;
dial_drag_oldy = 0;

spectrum_enabled = 1;
mouse_cap_prev = 0;

@slider
// sliders are polled at block rate in @block (and smoothed there), so
// nothing needs to happen immediately here.

@block
smooth_coef = exp(-samplesblock / (smooth_time * srate));

filt = 0;
while (filt < MAX_FILT) (
  freq_s[filt] = smooth_towards(per_to_freq(slider(1 + filt * 5)), freq_s[filt], smooth_coef);
  gain_s[filt] = smooth_towards(slider(2 + filt * 5), gain_s[filt], smooth_coef);
  q_s[filt] = smooth_towards(slider(3 + filt * 5), q_s[filt], smooth_coef);
  mute_gain_s[filt] = smooth_towards(slider(5 + filt * 5) > 0.5 ? 0 : 1, mute_gain_s[filt], smooth_coef);
  gain_lin[filt] = 10 ^ (gain_s[filt] / 20);

  new_slope = slider(4 + filt * 5);
  new_slope < prev_slope[filt] ? clear_stale_stage_state(filt, new_slope, prev_slope[filt]);
  slope[filt] = new_slope;
  prev_slope[filt] = new_slope;

  calc_filter_coefs(filt);
  filt += 1;
);

wideband_gain_s = smooth_towards(slider(61), wideband_gain_s, smooth_coef);
wideband_mute_gain_s = smooth_towards(slider(62) > 0.5 ? 0 : 1, wideband_mute_gain_s, smooth_coef);
wideband_gain_lin = 10 ^ (wideband_gain_s / 20);

@sample
spectrum_enabled ? ( spectrum.sample0((spl0 + spl1) * 0.5); );

upL.update_upHist2(spl0);
upR.update_upHist2(spl1);

os_stage = 0;
while (os_stage < OVERSAMPLE_FACTOR) (
  os_stage += 1;
  os_l = OVERSAMPLE_FACTOR * upL.upSample2();
  os_r = OVERSAMPLE_FACTOR * upR.upSample2();

  os_l = filterbank_process(0, os_l);
  os_r = filterbank_process(1, os_r);

  downL.update_downHist2(os_l);
  downR.update_downHist2(os_r);

  os_stage == 1 ? (
    spl0 = downL.downSample2();
    spl1 = downR.downSample2();
  );
);

spectrum_enabled ? ( spectrum.sample1((spl0 + spl1) * 0.5); );

@gfx 900 480
gfx_setfont(1);

gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(0, 0, gfx_w, gfx_h);

spectrum.draw_grid(0);
spectrum_enabled ? ( spectrum.draw(0); spectrum.draw(1); );

draw_response_curve();

process_mouse_nodes();
draw_filter_nodes();
draw_selected_indicator();

draw_bottom_panel();

handle_text_edit();

spectrum_enabled = draw_toggle_button(gfx_w - 110, 4, 100, 18, "Spectrum", spectrum_enabled);

mouse_cap_prev = mouse_cap;

