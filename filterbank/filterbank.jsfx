desc: Filterbank (plonk.studio)
version: 1.4
author: LFSaw
about:
	# filterbank
	A bank of 6 parallel bandpass filters, each with its own frequency,
	gain, resonance (Q) and slope (1-3 cascaded stages).
	Filters are dragged directly in the spectrum view (x = frequency,
	y = gain, mouse wheel = Q), muted individually, edited via a
	right-click menu, or typed in numerically.
	The wideband path is the dry input minus the unscaled filtered signal,
	so with every filter and the wideband at 0 dB the output equals the
	input. A filter's gain boosts or cuts just its own band, and the
	wideband gain scales everything outside the filters.
	Click a node to inspect/edit it in the panel below the spectrum.
link: https://plonk.studio
provides:
  [nomain] Dependencies/spectrum.jsfx-inc
  [nomain] Dependencies/oversample_upsamplers.jsfx-inc
  [nomain] Dependencies/fb_params.jsfx-inc
  [nomain] Dependencies/fb_svf.jsfx-inc
  [nomain] Dependencies/fb_resonator.jsfx-inc
  [nomain] Dependencies/fb_engine.jsfx-inc
  [nomain] Dependencies/fb_gui_widgets.jsfx-inc
  [nomain] Dependencies/fb_gui_graph.jsfx-inc
  [nomain] Dependencies/fb_gui_panels.jsfx-inc
changelog:
  - Reduced to 6 bands with a maximum slope of 3 stages; slider layout is now
    compact (globals first), so presets and automation from 1.3 do not carry over.
  - New Resonator filter mode (damped coupled-form resonator) with seconds-long
    decay (the Q control becomes DECAY, 0.02-30 s), stable at extreme settings and
    free of the tan() limit near Nyquist. Switching modes crossfades over 60 ms.
  - The wideband is now dry minus the unscaled filtered signal: every filter and
    the wideband at 0 dB give the exact input, a filter's gain only changes its own
    band, and the wideband scales what lies outside the filters (it is no longer a
    dry/wet control).
  - Parameter smoothing now really smooths (the previous coefficients made every
    ramp an instant jump), removing zipper noise on Q, frequency, gain and decay.
  - Large CPU reduction: dirty-checked parameter updates, only active filters are
    processed (muted ones are flushed once they have rung out), coefficients refresh
    every 16 samples while ramping, oversampling is optional (default off), and the
    spectrum is only fed and drawn while the GUI is open and its mode needs it.
  - Spectrum mode cycles Off / Pre / Pre+Post / Post, FFT size is selectable,
    the bottom panel dials are evenly spaced, and the Active/Muted pill is a small
    indicator button.

import Dependencies/spectrum.jsfx-inc
import Dependencies/oversample_upsamplers.jsfx-inc
import Dependencies/fb_params.jsfx-inc
import Dependencies/fb_svf.jsfx-inc
import Dependencies/fb_resonator.jsfx-inc
import Dependencies/fb_engine.jsfx-inc
import Dependencies/fb_gui_widgets.jsfx-inc
import Dependencies/fb_gui_graph.jsfx-inc
import Dependencies/fb_gui_panels.jsfx-inc

slider1:wideband_gain=0<-80,30,0.1>-Wideband Gain (dB)
slider2:wideband_mute=0<0,1,1>-Wideband Mute
slider3:tanh_distortion=0<0,1,1>-Tanh Distortion (all filters)
slider4:global_gain=0<-40,40,0.1>-Global Gain Offset (dB, all filters)
slider5:oversample=0<0,1,1>-Oversampling 2x (SVF mode)
slider6:fft_size=1<0,3,1{2048,4096,8192,16384}>-Spectrum FFT Size
slider7:spectrum_mode=0<0,3,1{Off,Pre,Pre+Post,Post}>-Spectrum Mode
slider8:filter_mode=0<0,1,1{SVF,Resonator}>-Filter Mode
slider9:freq1=13.0799<0,100,0.01>-Filter 1 Frequency (%)
slider10:gain1=0<-80,30,0.1>-Filter 1 Gain (dB)
slider11:q1=200<0.1,200,0.01>-Filter 1 Q
slider12:slope1=1<1,3,1>-Filter 1 Slope (stages)
slider13:mute1=0<0,1,1>-Filter 1 Mute
slider14:freq2=16.8251<0,100,0.01>-Filter 2 Frequency (%)
slider15:gain2=0<-80,30,0.1>-Filter 2 Gain (dB)
slider16:q2=200<0.1,200,0.01>-Filter 2 Q
slider17:slope2=1<1,3,1>-Filter 2 Slope (stages)
slider18:mute2=1<0,1,1>-Filter 2 Mute
slider19:freq3=20.3146<0,100,0.01>-Filter 3 Frequency (%)
slider20:gain3=0<-80,30,0.1>-Filter 3 Gain (dB)
slider21:q3=200<0.1,200,0.01>-Filter 3 Q
slider22:slope3=1<1,3,1>-Filter 3 Slope (stages)
slider23:mute3=1<0,1,1>-Filter 3 Mute
slider24:freq4=24.0731<0,100,0.01>-Filter 4 Frequency (%)
slider25:gain4=0<-80,30,0.1>-Filter 4 Gain (dB)
slider26:q4=200<0.1,200,0.01>-Filter 4 Q
slider27:slope4=1<1,3,1>-Filter 4 Slope (stages)
slider28:mute4=1<0,1,1>-Filter 4 Mute
slider29:freq5=27.6752<0,100,0.01>-Filter 5 Frequency (%)
slider30:gain5=0<-80,30,0.1>-Filter 5 Gain (dB)
slider31:q5=200<0.1,200,0.01>-Filter 5 Q
slider32:slope5=1<1,3,1>-Filter 5 Slope (stages)
slider33:mute5=1<0,1,1>-Filter 5 Mute
slider34:freq6=31.2855<0,100,0.01>-Filter 6 Frequency (%)
slider35:gain6=0<-80,30,0.1>-Filter 6 Gain (dB)
slider36:q6=200<0.1,200,0.01>-Filter 6 Q
slider37:slope6=1<1,3,1>-Filter 6 Slope (stages)
slider38:mute6=1<0,1,1>-Filter 6 Mute

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

options:gfx_hz=20

@init

fb_init();
fb_gui_init();

@slider
// sliders are polled at block rate in @block (and smoothed there), so
// nothing needs to happen immediately here.

@block
fb_block();

@sample
fb_sample();

@gfx 900 480
gui_last_t = time_precise();
gfx_setfont(1);

gfx_set(0.04, 0.04, 0.05, 1);
gfx_rect(0, 0, gfx_w, gfx_h);

spectrum.draw_grid(0);
spectrum_mode_gfx = slider(SL_SPECTRUM_MODE);
(spectrum_mode_gfx == 1 || spectrum_mode_gfx == 2) ? spectrum.draw(0);
(spectrum_mode_gfx == 2 || spectrum_mode_gfx == 3) ? spectrum.draw(1);

process_mouse_nodes();
// drawn after process_mouse_nodes() (which applies the current frame's
// drag/wheel updates to the sliders) so a dragged filter's shoulders
// move in the same frame as its dot, instead of trailing it by one.
curve_style_symbolic ? draw_symbolic_filters() : draw_response_curve();
draw_filter_nodes();
draw_selected_indicator();

draw_bottom_panel();

handle_text_edit();

draw_spectrum_mode_button(gfx_w - 150, 4, 140, 18);
draw_fft_button(gfx_w - 240, 4, 80, 18);
curve_style_symbolic = !draw_toggle_button(gfx_w - 350, 4, 100, 18, "Curve", !curve_style_symbolic);
draw_slider_toggle(gfx_w - 480, 4, 120, 18, slider(SL_FILTER_MODE) > 0.5 ? "Resonator" : "SVF", SL_FILTER_MODE, 0);
draw_slider_toggle(gfx_w - 550, 4, 60, 18, "2x OS", SL_OVERSAMPLE, slider(SL_FILTER_MODE) > 0.5);

mouse_cap_prev = mouse_cap;

